# Test-only environment, loaded by tests/setup/testEnv.ts (never by the app).
# Copy to .env.test. The URL MUST point at the database "leadpilot_test" on
# localhost (or 127.0.0.1 / [::1]) port 5432, with no query parameters other
# than schema=public, or the test run refuses to start — tests migrate and
# TRUNCATE it.
DATABASE_URL="postgresql://USER@localhost:5432/leadpilot_test?schema=public"
JWT_SECRET=
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:5000"
FOLLOW_UP_JOB_INTERVAL_MS=60000

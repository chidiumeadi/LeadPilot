// LeadPilot — Prisma schema
// Phase 1: authentication & business-account foundation (businesses, users,
// password reset tokens).
// Phase 3: lead management (leads).
// Phase 5: follow-up system (follow_ups) — records of intended follow-up
// actions only; nothing here executes automatically (see FollowUp below).
// Phase 6: internal notifications (notifications) generated by a scheduled
// job when a follow-up becomes due. No external message sending.
// Phase 8: lead pipeline & conversion (lead_activities, Lead.convertedAt) —
// a lightweight, append-only history of what happened to a lead, plus the
// timestamp of when it first reached CONVERTED status.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  category  String?
  phone     String?
  location  String?
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  leads          Lead[]
  followUps      FollowUp[]
  notifications  Notification[]
  leadActivities LeadActivity[]

  @@map("businesses")
}

model User {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]

  @@index([businessId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id          String     @id @default(uuid())
  businessId  String     @map("business_id")
  name        String
  email       String?
  phone       String?
  // Free-form (not an enum) so later phases can introduce new sources
  // (e.g. public form capture) without a schema migration.
  source      String     @default("MANUAL")
  status      LeadStatus @default(NEW)
  notes       String?
  // Set once, the first time a lead's status becomes CONVERTED (see
  // leadService.changeLeadStatus). Not cleared if the lead later moves to a
  // different status — it records "this lead did convert", not "is
  // currently converted" (that's what `status` is for).
  convertedAt DateTime?  @map("converted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  followUps     FollowUp[]
  notifications Notification[]
  activities    LeadActivity[]

  @@index([businessId])
  @@index([businessId, status])
  @@map("leads")
}

enum FollowUpType {
  CALL
  EMAIL
  SMS
  WHATSAPP
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// A record of a follow-up action the business INTENDS to perform for a
// lead. Phase 5 only creates/manages these records — nothing here is
// executed automatically (no cron/queue/worker/email/SMS/WhatsApp
// sending). Automated execution is Phase 6.
model FollowUp {
  id          String         @id @default(uuid())
  businessId  String         @map("business_id")
  leadId      String         @map("lead_id")
  type        FollowUpType
  status      FollowUpStatus @default(PENDING)
  scheduledAt DateTime       @map("scheduled_at")
  notes       String?
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([businessId])
  @@index([leadId])
  @@index([businessId, status])
  @@index([businessId, scheduledAt])
  @@map("follow_ups")
}

enum NotificationType {
  FOLLOW_UP_DUE
}

// An internal LeadPilot notification only — Phase 6 never sends anything
// through an external provider (no email/SMS/WhatsApp). followUpId/leadId
// are nullable with onDelete: SetNull so deleting a Follow-Up or Lead never
// leaves a dangling reference; the notification's own title/message text
// stays meaningful (and its read history intact) even if the record it
// referenced is later deleted.
model Notification {
  id         String           @id @default(uuid())
  businessId String           @map("business_id")
  followUpId String?          @map("follow_up_id")
  leadId     String?          @map("lead_id")
  type       NotificationType
  title      String
  message    String
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  followUp FollowUp? @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Idempotency boundary: at most one notification of a given type per
  // follow-up, enforced by the database — not just an application-level
  // "if not exists" check, which two overlapping scheduler runs could race.
  @@unique([followUpId, type])
  @@index([businessId])
  @@index([businessId, readAt])
  @@index([leadId])
  @@map("notifications")
}

enum LeadActivityType {
  LEAD_CREATED
  STATUS_CHANGED
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_CANCELLED
  FOLLOW_UP_NOTIFICATION_SENT
}

// A simple, append-only timeline of what happened to a lead — see
// leadActivityService.ts for where each type is written and how its
// `description` text is worded. `description` is plain text computed once
// at write time (not re-derived on every read), so there is exactly one
// place that decides what a "Lead converted" or "Status changed" sentence
// looks like.
//
// Unlike Notification, leadId here is a required, onDelete: Cascade
// relation: activity history is part of a lead's own record and has no
// reason to outlive the lead it describes.
model LeadActivity {
  id          String           @id @default(uuid())
  businessId  String           @map("business_id")
  leadId      String           @map("lead_id")
  type        LeadActivityType
  description String
  createdAt   DateTime         @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([leadId, createdAt])
  @@map("lead_activities")
}
